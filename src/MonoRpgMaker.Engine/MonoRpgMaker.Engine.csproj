<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonoRpgMaker.Abstractions\MonoRpgMaker.Abstractions.csproj" />
    <!-- The sim-determinism analyzer (D-0016) runs at build under -warnaserror. ReferenceOutputAssembly=false
         keeps it a build-time tool only (no runtime dependency). -->
    <ProjectReference Include="..\MonoRpgMaker.Analyzers\MonoRpgMaker.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>