# Build output. `bin/` is scoped to the project dirs so the hand-written quality
# gate at the repo root (bin/gate.sh) stays version-controlled — a bare `bin/`
# silently ignored it.
src/**/bin/
tests/**/bin/
obj/
artifacts/
*.user
*.suo
.vs/

# Test / coverage
[Tt]est[Rr]esults/
coverage/
*.coverage
*.cobertura.xml

# Rider / VS Code
.idea/
.vscode/

# macOS
.DS_Store

# MonoGame content intermediates
**/Content/bin/
**/Content/obj/

# Forge sidecar wiring — holds the bearer token (copy from .mcp.json.example)
.mcp.json

# Local run logs
.run/

# Stryker mutation testing output
StrykerOutput/
**/StrykerOutput/

# Harness scheduled-task lock
.claude/*.lock
