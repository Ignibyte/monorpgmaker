root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
# Analyzer severities default to AnalysisLevel=latest-recommended (Directory.Build.props);
# the gate (bin/gate.sh gate:2) makes warnings errors. Tune genuinely-inapplicable
# rules here (visible + reviewable config, not an inline suppression).

[*.{json,jsonc,yml,yaml,csproj,props,targets,slnx}]
indent_size = 2

[*.sh]
indent_size = 4

# Test projects: xUnit method names use Method_Scenario_Expectation underscores,
# test classes are public for discovery, and tests deliberately type locals as the
# interface under test (e.g. `IEventContext ctx = new EventContext(...)`) — all clash
# with general API/perf rules (CA1707/CA1515/CA1859) that don't apply to test code.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1859.severity = none
