<Project>
  <!--
    Shared build settings for every project in the solution. Kept central so the
    quality gate (bin/gate.sh) can tighten warnings/analyzers in one place.

    Roslyn analyzers are ON (warnings show in the IDE + normal builds); the gate
    makes them blocking with `dotnet build -warnaserror`, so the inner dev loop
    stays usable while `/commit` is strict (CONSTITUTION §0).
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      Reproducible restores: every project emits a packages.lock.json pinning the
      full transitive graph (the NuGet analogue of Cargo.lock). The gate restores
      in locked mode, so a drifted graph fails the build instead of silently
      resolving something new. Lock files are committed.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    First-class source bans (CONSTITUTION §14): BannedApiAnalyzers makes the
    compiler refuse the symbols listed in BannedSymbols.txt (RS0030), enforced
    under -warnaserror across every project. This is the primary enforcement;
    the gate.sh grep meta-gate stays as a cheap backstop.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
