<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The engine's public API exposes XNA types (e.g. Point), so tests need the reference. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <!-- Architecture guardrails (CONSTITUTION §14): the layering rules asserted as xUnit tests. -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Drives the sim-determinism analyzer over in-memory snippets (SimDeterminismAnalyzerTests). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The committed sample $data map (MapSerializerTests reads it at runtime). -->
    <None Include="Fixtures/sample-map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MonoRpgMaker.Abstractions\MonoRpgMaker.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\MonoRpgMaker.Engine\MonoRpgMaker.Engine.csproj" />
    <!-- Plain library reference (NOT OutputItemType=Analyzer): the tests instantiate the analyzer and
         call its internal SimScope helpers (InternalsVisibleTo) directly; it does not analyze the tests. -->
    <ProjectReference Include="..\..\src\MonoRpgMaker.Analyzers\MonoRpgMaker.Analyzers.csproj" />
    <!-- The maker tool hosts the .expect oracle (parser/runner/CLI + MapEditor), unit-tested here. -->
    <ProjectReference Include="..\..\src\MonoRpgMaker.Editor\MonoRpgMaker.Editor.csproj" />
  </ItemGroup>

</Project>